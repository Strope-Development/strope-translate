{
	"name": "strope/strope-translate-tests",
	"description": "Development tools of Strope Translate. Not shipped with the plugin.",
	"license": "GPL-3.0-or-later",
	"require-dev": {
		"php": ">=7.4",
		"phpunit/phpunit": "^9.6",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"squizlabs/php_codesniffer": "^3.9",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "parallel-lint --exclude ../vendor --exclude ../node_modules --exclude vendor ..",
		"compat": "phpcs --standard=phpcs-compat.xml.dist",
		"test": "phpunit -c phpunit.xml.dist",
		"check": [
			"@lint",
			"@compat",
			"@test"
		]
	}
}
